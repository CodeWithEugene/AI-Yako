# Yako environment example. Copy to .env and fill real values locally.
# The app itself needs no API keys. Every AI feature runs on-device.
# This file exists so the secrets policy (SECURITY.md) has a placeholder to point at.

# Optional path to a custom QVAC config file.
# QVAC_CONFIG_PATH=./qvac.config.json

# Optional local model cache override.
# QVAC_CACHE_DIR=./.qvac
