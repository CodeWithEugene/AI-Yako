{
  "name": "yako",
  "version": "0.1.0",
  "private": true,
  "description": "Yako. Offline English-Swahili translator built on QVAC. AI Yako hackathon, Track 1.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "setup": "node dist/setup/setup.js",
    "dev": "node --watch -r tsx/cjs src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format"
  },
  "dependencies": {
    "@qvac/llm-llamacpp": "^0.65.0",
    "@qvac/sdk": "^0.22.0",
    "@qvac/transcription-whispercpp": "^0.12.1",
    "@qvac/tts-ggml": "^0.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
